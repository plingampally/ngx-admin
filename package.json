{
  "name": "ngx-admin",
  "version": "10.0.0",
  "license": "MIT",
  "engines": {
    "node": "20.x",
    "npm": ">=9"
  },
  "overrides": {
    "@babel/runtime": "$@babel/runtime"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akveo/ngx-admin.git"
  },
  "bugs": {
    "url": "https://github.com/akveo/ngx-admin/issues"
  },
  "scripts": {
    "ng": "ng",
    "preinstall": "node -e \"if (!/^20\\./.test(process.versions.node)) { console.error('ngx-admin requires Node 20.x, you are running ' + process.version); process.exit(1); }\"",
    "conventional-changelog": "conventional-changelog",
    "start": "ng serve",
    "dev": "NG_CLI_ANALYTICS=false PATH=\"$HOME/.n/n/versions/node/20.20.2/bin:$PATH\" ng serve --port \"${PORT:-4218}\"",
    "dev:portless": "PATH=\"$HOME/.nvm/versions/node/v24.7.0/bin:$PATH\" portless ngx-admin-v18 npm run dev",
    "build": "ng build",
    "build:prod": "npm run build -- --configuration production --aot",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:coverage": "rimraf coverage && npm run test -- --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint ngx-admin-demo --fix",
    "lint:styles": "stylelint ./src/**/*.scss",
    "lint:ci": "npm run lint && npm run lint:styles",
    "e2e:pw": "playwright test",
    "e2e:pw:update": "playwright test --update-snapshots",
    "e2e:pw:report": "playwright show-report",
    "docs": "compodoc -p src/tsconfig.app.json -d docs",
    "docs:serve": "compodoc -p src/tsconfig.app.json -d docs -s",
    "prepush": "npm run lint:ci",
    "release:changelog": "npm run conventional-changelog -- -p angular -i CHANGELOG.md -s"
  },
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/cdk": "17.2.1",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/google-maps": "17.2.1",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@asymmetrik/ngx-leaflet": "17.0.0",
    "@nebular/auth": "13.0.0",
    "@nebular/eva-icons": "13.0.0",
    "@nebular/security": "13.0.0",
    "@nebular/theme": "13.0.0",
    "@swimlane/ngx-charts": "20.5.0",
    "angular2-smart-table": "3.8.0",
    "bootstrap": "4.3.1",
    "chart.js": "2.7.1",
    "ckeditor": "4.7.3",
    "classlist.js": "1.1.20150312",
    "core-js": "2.5.1",
    "echarts": "5.6.0",
    "eva-icons": "^1.1.3",
    "intl": "1.2.5",
    "ionicons": "2.0.1",
    "leaflet": "1.2.0",
    "lodash-es": "4.17.21",
    "nebular-icons": "1.1.0",
    "ng2-ckeditor": "1.3.7",
    "ngx-echarts": "17.2.0",
    "normalize.css": "6.0.0",
    "pace-js": "1.0.2",
    "roboto-fontface": "0.8.0",
    "rxjs": "6.6.2",
    "socicon": "3.0.5",
    "style-loader": "^1.3.0",
    "tinymce": "4.5.7",
    "tslib": "^2.3.1",
    "typeface-exo": "0.0.22",
    "web-animations-js": "^2.3.2",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular-eslint/builder": "17.5.3",
    "@angular-eslint/eslint-plugin": "17.5.3",
    "@angular-eslint/eslint-plugin-template": "17.5.3",
    "@angular-eslint/schematics": "17.5.3",
    "@angular-eslint/template-parser": "17.5.3",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@angular/language-service": "18.2.14",
    "@babel/runtime": "^7.28.6",
    "@compodoc/compodoc": "1.0.1",
    "@fortawesome/fontawesome-free": "^5.2.0",
    "@playwright/test": "1.49.1",
    "@types/ckeditor": "4.9.10",
    "@types/d3-color": "1.0.5",
    "@types/google.maps": "3.55.12",
    "@types/jasmine": "~3.10.18",
    "@types/leaflet": "1.2.3",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.5.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "conventional-changelog-cli": "1.3.4",
    "eslint": "^8.57.0",
    "husky": "0.13.3",
    "jasmine-core": "~3.99.1",
    "karma": "~6.3.19",
    "karma-chrome-launcher": "~3.1.1",
    "karma-cli": "1.0.1",
    "karma-coverage": "^2.2.1",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.2",
    "karma-jasmine-html-reporter": "^1.7.0",
    "npm-run-all": "4.0.2",
    "rimraf": "2.6.1",
    "stylelint": "7.13.0",
    "typescript": "~5.4.5"
  }
}
